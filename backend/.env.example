# Reddit
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=memeradar/0.1 by yourname
SUBREDDIT=memes
TIME_FILTER=year
LIMIT=1000

# Qdrant (use Qdrant Cloud free tier or local binary)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=memeradar

# Twelve Labs
TL_API_KEY=
TL_MODEL=Marengo-retrieval-2.7

# Mistral
MISTRAL_API_KEY=
MISTRAL_CHAT_MODEL=mistral-large-latest
MISTRAL_EMBED_MODEL=mistral-embed

# Neo4j (use Neo4j Aura free tier or local binary)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme

# Cognee LLM (defaults to MISTRAL_API_KEY)
COGNEE_LLM_API_KEY=

# Paths
DATA_DIR=./data
